rules_version = '2';

// Reglas de seguridad de Firestore — Sprint 2 (identidad y negocio) +
// Sprint 3 (ventas) + Sprint 4 (edición y eliminación de ventas).
//
// Modelo de datos:
//   users/{uid}                         → perfil (name, businessId)
//   businesses/{businessId}             → negocio (name, joinCode, createdBy)
//   businesses/{businessId}/users/{uid} → membresía (uid, name, role, createdAt)
//   businesses/{businessId}/sales/{id}  → venta (serviceType, quantity,
//                                         unitPriceCents, totalCents,
//                                         createdBy, createdByName,
//                                         createdAt, updatedAt, notes?,
//                                         updatedBy?, updatedByName?)
//   joinCodes/{code}                    → { businessId } (búsqueda por código)
//
// Principios:
//   - Todo requiere autenticación (Anonymous Authentication).
//   - Los roles y businessId enviados por el cliente NO se confían:
//     cada escritura se valida contra documentos existentes.
//   - No se permite listar negocios ni códigos (solo lecturas puntuales).
//   - El cambio de propietario, edición y borrado de negocios/membresías
//     quedan bloqueados (no forman parte de este sprint).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ===== Perfiles de usuario =====
    match /users/{userId} {
      // Cada usuario solo puede leer su propio perfil.
      allow read: if isSignedIn() && request.auth.uid == userId;

      // El perfil nace sin negocio y con el uid correcto.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.businessId == null;

      // El usuario puede actualizar su perfil, pero:
      //  - el uid del documento no puede cambiar;
      //  - businessId solo puede mantenerse igual o apuntar a un negocio
      //    existente (la membresía es quien autoriza el acceso real).
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (
          request.resource.data.businessId == resource.data.businessId
          || (
            request.resource.data.businessId is string
            && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
          )
        );

      allow delete: if false;
    }

    // ===== Códigos de invitación =====
    // Colección de búsqueda: dado un código, obtener su businessId.
    // Solo se permite `get` (probar un código concreto); nunca `list`,
    // para evitar enumerar negocios ajenos.
    match /joinCodes/{code} {
      allow get: if isSignedIn();

      // Solo el creador del negocio puede registrar SU código (el guardado
      // en el propio negocio) apuntando a SU negocio.
      allow create: if isSignedIn()
        && request.resource.data.businessId is string
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.joinCode == code;

      allow update, delete: if false;
    }

    // ===== Negocios =====
    match /businesses/{businessId} {

      // Solo los miembros del negocio pueden leerlo.
      function isMember() {
        return exists(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid));
      }

      // El propietario del negocio es quien lo creó; es el mismo criterio
      // que valida la membresía con rol "owner" (Sprint 2) y el que usa la
      // interfaz (`business.createdBy`).
      function isBusinessOwner() {
        return get(/databases/$(database)/documents/businesses/$(businessId)).data.createdBy
          == request.auth.uid;
      }

      function profileHasNoBusiness() {
        return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == null;
      }

      allow read: if isSignedIn() && isMember();

      // Cualquier usuario autenticado sin negocio puede crear UN negocio,
      // siempre que aparezca como su creador y los campos sean válidos.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() == 6
        && profileHasNoBusiness();

      // La edición, transferencia y borrado del negocio quedan fuera de
      // este sprint.
      allow update, delete: if false;

      // ===== Membresías =====
      match /users/{memberId} {
        // Solo los miembros del negocio pueden ver la lista de membresías
        // (acceso puntual por documento; no hay consultas con índices).
        allow read: if isSignedIn() && isMember();

        // La membresía siempre la crea el propio usuario, sobre su uid.
        // Dos caminos válidos:
        //  1) Propietario: creó este negocio (rol "owner").
        //  2) Miembro: presenta un código válido que apunta a ESTE negocio
        //     y su perfil no pertenece ya a otro negocio (rol "member").
        allow create: if isSignedIn()
          && request.auth.uid == memberId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && exists(/databases/$(database)/documents/businesses/$(businessId))
          && (
            (
              request.resource.data.role == 'owner'
              && get(/databases/$(database)/documents/businesses/$(businessId)).data.createdBy == request.auth.uid
            )
            || (
              request.resource.data.role == 'member'
              && request.resource.data.joinCode is string
              && exists(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
              && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.businessId == businessId
              && profileHasNoBusiness()
            )
          );

        // El cambio de rol (incluido quitar la propiedad) y el borrado de
        // membresías quedan bloqueados en este sprint.
        allow update, delete: if false;
      }

      // ===== Ventas (Sprint 3 + Sprint 4) =====
      //
      // - Cualquier miembro autorizado del negocio puede leer y crear ventas.
      // - El creador de una venta puede editarla o eliminarla.
      // - El propietario del negocio puede editar o eliminar cualquier venta.
      // - Nadie ajeno al negocio puede leer, crear, editar ni eliminar
      //   ventas (las reglas se aplican también fuera de la aplicación).
      // - Los límites numéricos coinciden con las constantes de
      //   `src/services/saleValidation.ts`.
      match /sales/{saleId} {

        // Lista de campos que puede tener un documento de venta. Los campos
        // de auditoría de edición (`updatedBy`, `updatedByName`) se añadieron
        // en el Sprint 4 y son obligatorios tras una edición.
        function saleFieldNames() {
          return ['serviceType', 'quantity', 'unitPriceCents', 'totalCents',
                  'createdBy', 'createdByName', 'createdAt', 'updatedAt',
                  'notes', 'updatedBy', 'updatedByName'];
        }

        // Validación de los campos editables, compartida por crear y editar.
        // El precio unitario mínimo es 1 centavo: un servicio sin tarifa
        // sugerida debe capturarse manualmente y nunca puede ser $0.00.
        function saleContentIsValid(data) {
          return data.serviceType in
                   ['COPY_BW', 'COPY_COLOR', 'PRINT_BW', 'PRINT_COLOR', 'RECHARGE', 'OTHER']
                && data.quantity is int
                && data.quantity >= 1
                && data.quantity <= 1000
                && data.unitPriceCents is int
                && data.unitPriceCents >= 1
                && data.unitPriceCents <= 10000000
                && data.totalCents is int
                && data.totalCents == data.quantity * data.unitPriceCents
                && (
                  !('notes' in data)
                  || (data.notes is string && data.notes.size() <= 200)
                );
        }

        // Un documento de venta nuevo es válido si cumple el contrato
        // completo: campos exactos (con `notes` opcional), tipos correctos,
        // límites razonables, total coherente, registrante autenticado y
        // timestamps de servidor.
        function saleIsValid() {
          return request.resource.data.keys().hasAll(
                   ['serviceType', 'quantity', 'unitPriceCents', 'totalCents',
                    'createdBy', 'createdByName', 'createdAt', 'updatedAt']
                 )
                 && request.resource.data.keys().hasOnly(saleFieldNames())
                 && saleContentIsValid(request.resource.data)
                 && request.resource.data.createdBy == request.auth.uid
                 && request.resource.data.createdByName is string
                 && request.resource.data.createdByName.size() >= 1
                 && request.resource.data.createdByName.size() <= 50
                 && request.resource.data.createdAt == request.time
                 && request.resource.data.updatedAt == request.time
                 && !('updatedBy' in request.resource.data);
        }

        // Puede tocar (editar o eliminar) esta venta quien la creó o el
        // propietario del negocio; en ambos casos debe seguir siendo
        // miembro del negocio.
        function canModifyThisSale() {
          return isMember()
                 && (isBusinessOwner()
                     || resource.data.createdBy == request.auth.uid);
        }

        // Una edición es válida si:
        //  - los campos históricos no cambian (`createdBy`, `createdByName`,
        //    `createdAt`);
        //  - los campos finales cumplen el esquema permitido y el total
        //    sigue siendo coherente;
        //  - la auditoría de edición es correcta: `updatedAt` con timestamp
        //    del servidor y `updatedBy` con el UID autenticado.
        function saleUpdateIsValid() {
          return request.resource.data.keys().hasAll(
                   ['serviceType', 'quantity', 'unitPriceCents', 'totalCents',
                    'createdBy', 'createdByName', 'createdAt', 'updatedAt',
                    'updatedBy', 'updatedByName']
                 )
                 && request.resource.data.keys().hasOnly(saleFieldNames())
                 && saleContentIsValid(request.resource.data)
                 && request.resource.data.createdBy == resource.data.createdBy
                 && request.resource.data.createdByName == resource.data.createdByName
                 && request.resource.data.createdAt == resource.data.createdAt
                 && request.resource.data.updatedAt == request.time
                 && request.resource.data.updatedBy == request.auth.uid
                 && request.resource.data.updatedByName is string
                 && request.resource.data.updatedByName.size() >= 1
                 && request.resource.data.updatedByName.size() <= 50;
        }

        // Cualquier miembro del negocio puede consultar las ventas, tanto la
        // consulta inicial como la suscripción en tiempo real (`onSnapshot`,
        // Sprint 4).
        allow read: if isSignedIn() && isMember();

        // Solo los miembros pueden crear ventas, siempre que el documento
        // cumpla el contrato y figure el propio UID como registrante.
        allow create: if isSignedIn() && isMember() && saleIsValid();

        // Solo el creador de la venta o el propietario del negocio pueden
        // editarla, con el esquema y la auditoría intactos.
        allow update: if isSignedIn() && canModifyThisSale() && saleUpdateIsValid();

        // Solo el creador de la venta o el propietario del negocio pueden
        // eliminarla. La eliminación es permanente: no existe papelera ni
        // borrado lógico en el modelo actual.
        allow delete: if isSignedIn() && canModifyThisSale();
      }
    }
  }
}
